DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# Relative to backend/ by default; Render can set this to /etc/secrets/prod-ca-2021.crt.
SUPABASE_CA_CERT_PATH=certs/prod-ca-2021.crt
PORT=3000
NODE_ENV=development
SESSION_SECRET=generate-a-random-64-character-secret
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=lax
# Used only by `npm run admin:bootstrap`; remove after the first administrator is created.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Optional SMTP settings; contact form returns a service error until configured.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
