DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/portfolio_db
PORT=3000
NODE_ENV=development
SESSION_SECRET=generate-a-random-64-character-secret
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=lax
# Used only by `npm run admin:bootstrap`; remove after the first administrator is created.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Optional SMTP settings; contact form returns a service error until configured.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
